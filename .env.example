# MongoDB URLs
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority"
BLOG_DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/blog_database_name?retryWrites=true&w=majority"

# NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_secret_key"
NEXTAUTH_URL="https://yourdomain.com"
AUTH_TRUST_HOST=true

# App Routing URLs
APP_URL="https://yourdomain.com"
ADMIN_API_URL="https://admin.yourdomain.com"

# Cloudinary Assets Hosting
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Optional Keys
GEMINI_API_KEY="your_gemini_api_key_here"

# Google Site Verification Code for Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your_google_site_verification_code_here"

# Meta (Facebook) Pixel ID. Leave unset to disable the pixel. Must be present at BUILD time.
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Lead notifications (nodemailer SMTP, e.g. your hosting mailbox) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Stitchbyte <info@stitchbyte.in>"
# Where internal "new lead" alerts go (comma-separate for several people)
LEAD_NOTIFY_TO=info@stitchbyte.in

# --- Meta Conversions API (server-side Lead events) ---
# Pixel ID above must be the REAL 15-16 digit ID. Token: Events Manager > Settings > Conversions API.
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager "Test events" code, remove in production
META_CAPI_TEST_CODE=

# Secret for the 5-minute reminder cron (/api/leads/reminders). Use a long random string.
CRON_SECRET=
REMINDER_AFTER_MINUTES=5

# Decrypts secrets saved from the admin Integrations page. Must equal the admin panel's value.
# Settings saved in the admin override the Meta/SMTP/LEAD_NOTIFY_TO values above; those act as fallback.
SETTINGS_ENCRYPTION_KEY=
